{
  "entities": {
    "Lesson": {
      "title": "Lesson",
      "description": "A study lesson generated by the AI.",
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "description": "The topic of the lesson."
        },
        "subject": {
          "type": "string",
          "description": "The subject category of the lesson (e.g., Matematika, Historie)."
        },
        "video_url": {
          "type": "string",
          "description": "URL of a related YouTube video."
        },
        "study_json": {
          "type": "string",
          "description": "JSON stringified study result object."
        },
        "image_url": {
          "type": "string",
          "description": "URL of the generated topic image."
        },
        "files": {
          "type": "string",
          "description": "JSON stringified array of StudyFile objects."
        },
        "images": {
          "type": "string",
          "description": "JSON stringified array of image URLs."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "The time the lesson was created."
        },
        "projectId": {
          "type": "string",
          "description": "The project ID associated with the lesson."
        },
        "uid": {
          "type": "string",
          "description": "The user ID of the creator."
        },
        "parentId": {
          "type": "string",
          "description": "Optional parent ID for nested lessons."
        },
        "topicId": {
          "type": "string",
          "description": "Optional ID of the topic within a curriculum."
        }
      },
      "required": ["topic", "study_json", "created_at", "uid"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and preferences.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher", "admin"],
          "description": "The user's role."
        },
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "description": "The user's photo URL."
        },
        "bio": {
          "type": "string",
          "description": "The user's bio."
        },
        "status": {
          "type": "string",
          "enum": ["online", "offline", "away"],
          "description": "The user's status."
        },
        "selectedAvatarId": {
          "type": "string",
          "description": "ID of the selected assistant avatar."
        },
        "avatarURL": {
          "type": "string",
          "description": "Cached URL of the selected avatar."
        },
        "avatarPoses": {
          "type": "object",
          "description": "Cached poses of the selected avatar."
        },
        "grade": {
          "type": "number",
          "description": "User's grade/year of study."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile creation timestamp."
        }
      },
      "required": ["email", "uid"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message between users.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "description": "The ID of the sender."
        },
        "receiverId": {
          "type": "string",
          "description": "The ID of the receiver."
        },
        "text": {
          "type": "string",
          "description": "The message text."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "The time the message was sent."
        }
      },
      "required": ["senderId", "receiverId", "text", "timestamp"]
    },
    "Identity": {
      "title": "Identity",
      "description": "A neural identity (avatar profile) shared across all users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique ID of the identity." },
        "ownerId": { "type": "string", "description": "ID of the user who created this identity." },
        "displayName": { "type": "string", "description": "Display name of the identity." },
        "bio": { "type": "string", "description": "Biography/Description of the identity." },
        "avatarURL": { "type": "string", "description": "URL of the avatar image." },
        "avatarPoses": { "type": "object", "description": "Collection of pose URLs." },
        "level": { "type": "number", "description": "Character level." },
        "xp": { "type": "number", "description": "Current experience points." },
        "maxXP": { "type": "number", "description": "Experience points needed for level up." },
        "stats": { "type": "object", "description": "Identity statistics." }
      },
      "required": ["uid", "displayName"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "A user's study schedule.",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "description": "List of schedule items.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "day": { "type": "string" },
              "startTime": { "type": "string" },
              "endTime": { "type": "string" },
              "subject": { "type": "string" },
              "topic": { "type": "string" },
              "completed": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["items"]
    },
    "Curriculum": {
      "title": "Curriculum",
      "description": "A published study plan or curriculum.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plan": { "type": "object" },
        "level": { "type": "string", "enum": ["elementary", "high"] },
        "timestamp": { "type": "number" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "likes": { "type": "number" },
        "saves": { "type": "number" }
      },
      "required": ["plan", "authorId", "isPublished", "timestamp"]
    },
    "ApiKey": {
      "title": "ApiKey",
      "description": "User custom Gemini and Cloudinary API configurations.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "The Gemini API key string." },
        "cloudinaryCloudName": { "type": "string", "description": "Cloudinary cloud name." },
        "cloudinaryUploadPreset": { "type": "string", "description": "Cloudinary upload preset." },
        "cloudinaryApiKey": { "type": "string", "description": "Cloudinary API key." },
        "cloudinaryApiSecret": { "type": "string", "description": "Cloudinary API secret." },
        "ownerId": { "type": "string", "description": "UID of the owner." },
        "sharedWith": { "type": "array", "items": { "type": "string" }, "description": "List of emails this config is shared with." }
      },
      "required": ["ownerId"]
    }
  },
  "firestore": {
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Collection of study lessons."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles."
    },
    "/avatars/{avatarId}": {
      "schema": "Identity",
      "description": "Global collection of shared assistant avatars available to all users."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Collection of chat messages."
    },
    "/schedules/{userId}": {
      "schema": "Schedule",
      "description": "A collection where the document ID is the user ID, storing their schedule."
    },
    "/curricula/{curriculumId}": {
      "schema": "Curriculum",
      "description": "Collection of published study plans."
    },
    "/api_keys/{userId}": {
      "schema": "ApiKey",
      "description": "User custom Gemini API keys collection."
    },
    "/admins/{adminId}": {
      "schema": { "type": "object", "properties": { "role": { "type": "string" } } },
      "description": "Collection of admin user IDs."
    },
    "/test/{testId}": {
      "schema": { "type": "object", "properties": { "status": { "type": "string" } } },
      "description": "Temporary collection used for testing database connectivity."
    }
  }
}
