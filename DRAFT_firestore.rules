rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (isEmailVerified() && request.auth.token.email in ['chlupatejtypek@gmail.com', 'kamiljoven2@gmail.com']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- VALIDATION BLUEPRINTS ---

    function isValidLesson(data) {
      // Create validation: exact keys
      // Update validation: must handle partial but we use affectedKeys().hasOnly() so this is for shape
      let requiredFields = ['topic', 'study_json', 'created_at', 'uid', 'subject', 'projectId'];
      return data.keys().hasAll(requiredFields) &&
             data.topic is string && data.topic.size() <= 200 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.study_json is string && data.study_json.size() <= 1048576 && // 1MB limit
             data.uid == request.auth.uid &&
             data.created_at == request.time &&
             (data.video_url == null || (data.video_url is string && data.video_url.size() <= 500)) &&
             (data.image_url == null || (data.image_url is string && data.image_url.size() <= 1000));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'uid']) &&
             data.email is string && data.email.size() <= 256 &&
             data.uid == request.auth.uid &&
             (!('role' in data) || data.role in ['student', 'teacher', 'admin']) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'receiverId', 'text', 'timestamp']) &&
             data.senderId == request.auth.uid &&
             data.receiverId is string && data.receiverId.size() <= 128 &&
             data.text is string && data.text.size() <= 2000 &&
             data.timestamp == request.time;
    }

    function isValidCurriculum(data) {
      return data.keys().hasAll(['plan', 'authorId', 'isPublished', 'timestamp']) &&
             data.authorId == request.auth.uid &&
             data.isPublished is bool &&
             data.timestamp == request.time;
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['items']) &&
             data.items is list && data.items.size() <= 100; // Guard against denial of wallet
    }

    // --- MATCH BLOCKS ---

    match /lessons/{lessonId} {
      allow get: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(lessonId) && isValidLesson(incoming()) && incoming().keys().size() <= 12;
      allow update: if isOwner(existing().uid) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'subject', 'video_url', 'study_json', 'image_url', 'files', 'images', 'parentId', 'topicId'])
      ) && incoming().uid == existing().uid; 
      allow delete: if isOwner(existing().uid) || isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // PII protection
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().keys().size() <= 12;
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'status', 'selectedAvatarId', 'avatarURL', 'avatarPoses', 'grade'])
      ) && incoming().uid == existing().uid && incoming().email == existing().email;
      allow delete: if isAdmin();
    }

    match /avatars/{avatarId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      allow get: if isSignedIn() && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(messageId) && isValidMessage(incoming());
      allow delete: if isAdmin() || (isSignedIn() && existing().senderId == request.auth.uid);
    }

    match /schedules/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidSchedule(incoming());
      allow update: if isOwner(userId) && isValidSchedule(incoming()) && incoming().items.size() <= 100;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /curricula/{curriculumId} {
      allow list: if isSignedIn() && (resource.data.isPublished == true || resource.data.authorId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && isValidId(curriculumId) && (existing().isPublished == true || existing().authorId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidId(curriculumId) && isValidCurriculum(incoming());
      allow update: if isOwner(existing().authorId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['plan', 'isPublished', 'likes', 'saves', 'timestamp'])
      ) && incoming().authorId == existing().authorId; 
      allow delete: if isOwner(existing().authorId) || isAdmin();
    }

    match /test/{testId} {
      allow read, write: if isSignedIn();
    }

    // Admins collection for role lookup
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // System managed or manually set
    }
  }
}
